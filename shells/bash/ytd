#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

ytd() {
    err() {
        trap - INT TERM EXIT

        if [ "$1" != 0 ]; then
            printf "%s" \
'
$1 -> url
$2 -> fname
$3 -> cookies.txt path
$4 *0* -> `--format bestaudio[format_id~=^140][language^=en]`, yt-dlp only
$4 *1* -> `--format bestvideo[height<=1080]`, yt-dlp only
$4 *2* -> `--format bestvideo[height<=1440]`, yt-dlp only
$4 *a* -> write the auto-generated subs
$4 *b* -> `--format bestaudio`, `--format bestvideo`
$4 *f* -> dont recognize/append extension, fname is fully authoritative
$4 *m* -> dont use `--mtime`
$4 *n* -> `--fixup never`
$4 *o* -> dont use `-o` / dont custom format filename
$4 *s* -> convert subtitles to `srt` using ffmpeg before embed
$4 *t* -> `--no-part --no-cache-dir`, no cleanup/move (only on success)
$4 *u* -> download in current dir
$4 *v* -> `--verbose`
$4 *x* -> dont try to download any subtitles
$4 *y* -> use yt-dlp
$4 *z* -> use youtube-dl
'

            rm -rf "$ODIR"
        fi

        case "$OPTS" in
            *t*) : ;;
            *) rm -rf "$ODIR" ;;
        esac

        exit "$1"
    }

    set -e
    _destroy_cookies=
    ODIR=
    trap "err \$?" INT TERM EXIT

    URL="$1"
    FNAME="$2"
    COOKIES="$3"
    OPTS="$4"
    DIR="$PWD"
    FILE=

    case "$OPTS" in
        *u*) _ODIR="$DIR"/.ytd ;;
        *) _ODIR="${TMPDIR:-/tmp}"/.ytd ;;
    esac

    if [ -e "$_ODIR" ]; then
        printf "%s" "Sweetie, '$_ODIR' already exists... Shall I delete it? [y/N] "

        read -r _action; [ "$_action" ] || _action=N
        case "$_action" in
            [Yy]*) ODIR="$_ODIR" ;;
            *) printf "%s\n" 'Sweetheart... wise choice! Deal with it.'; exit 1 ;;
        esac
    else
        ODIR="$_ODIR"
    fi

    [ "$URL" ] || { printf "%s\n" 'No URL specified.'; exit 2; }

    # guarantee we are in our custom empty dir
    # otherwise globbing cannot be trusted
    rm -rf "$ODIR"
    mkdir "$ODIR"
    cd "$ODIR"

    # scan for cookies.txt file
    if [ ! "$COOKIES" ]; then while :; do
        set -- *cookies.txt ../*cookies.txt
        while [ "$#" -ge 1 ] || break 2; do
            [ -e "$1" ] && break || shift
        done

        _cookies="$1"
        _cookies="$(realpath -- "$_cookies" && printf "%s" .)"
        _cookies="${_cookies%?.}"

        printf "%s" "Honey, should I use the cookies at '$_cookies'? [y/N] "

        read -r _action; [ "$_action" ] || _action=N
        case "$_action" in
            [Yy]*) COOKIES="$_cookies"; _destroy_cookies=1 ;;
            *) printf "%s\n" 'Will not use the cookies.' ;;
        esac

        break
    done; fi

    # ensure ffmpeg_merge, yt_a, yt_s, and yt_v respect working in our dir by
    # pointing $TMPDIR to $ODIR (they shall support $TMPDIR)
    export TMPDIR="$ODIR"

    # download audio first to prematurely discover any problems
    yt_a "$URL" '' "$COOKIES" t"$OPTS"
    yt_v "$URL" '' "$COOKIES" t"$OPTS"
    case "$OPTS" in
        *x*)
            echo 'Will not try to download any subtitles.'
        ;;
        *)
            s=0
            echo 'Querying subtitles...'

            case "$OPTS" in
                *a*)
                    if yt_s "$URL" '' "$COOKIES" t"$OPTS" > /dev/null; then
                        s=2
                    fi
                ;;
                *)
                    if yt_s "$URL" '' "$COOKIES" t"$OPTS" > /dev/null; then
                        s=1
                    elif yt_s "$URL" '' "$COOKIES" at"$OPTS" > /dev/null; then
                        s=2
                    fi
                ;;
            esac

            case "$s" in
                0) printf "%b%s%b\n" '\033[1;37m' 'No subtitles available.' '\033[0m' ;;
                1) printf "%b%s%b\n" '\033[1;37m' 'Subtitles available.' '\033[0m' ;;
                2) printf "%b%s%b\n" '\033[1;37m' 'Auto-generated subtitles available.' '\033[0m' ;;
            esac
        ;;
    esac

    # construct $OPTS as $1 for ffmpeg_merge
    case "$OPTS" in
        *u*) set -- tu ;;
        *) set -- t ;;
    esac

    if [ "$s" = 0 ]; then
        ffmpeg_merge "$ODIR"/.yt_v/* "$ODIR"/.yt_a/* '' '' "$1"
    else
        ffmpeg_merge "$ODIR"/.yt_v/* "$ODIR"/.yt_a/* "$ODIR"/.yt_s/* '' s"$1"
    fi

    # from now on guarantee $FILE is just the filename as we are in our dir
    # simplifies operations
    cd "$ODIR"/.ffmpeg_merge
    set -- *
    FILE="$1"
    if [ ! -e "$FILE" ]; then
        set -- .*; while [ "$1" ]; do case "$1" in
            '.' | '..') shift ;;
            *) FILE="$1" && break ;;
        esac; done
    fi
    [ -e "$FILE" ] || { printf "%s\n" 'File glob failed. (ENOENT)'; exit 1; }
    [ ! -d "$FILE" ] || { printf "%s\n" 'File glob failed. (EISDIR)'; exit 1; }

    # rename in our dir
    # if $FILE has extension, append it to $FNAME
    if [ "$FNAME" ]; then
        case "$OPTS" in
            *f*)
                :
            ;;
            *)
                case "$FILE" in
                    *.?? | *.??? | *.????) FNAME="$FNAME.${FILE##*.}" ;;
                esac
            ;;
        esac

        # guard same filename rename
        case "$FILE" in
            "$FNAME") : ;;
            *) mv "$FILE" "$FNAME" ;;
        esac

        FILE="$FNAME"
    fi

    # move result to dest
    case "$OPTS" in
        *t*)
            rm -rf "$ODIR"/.yt_a "$ODIR"/.yt_s "$ODIR"/.yt_v

            printf "%b%s%b %b%s%b\n" \
                '\033[1;32m' 'FILE:' '\033[0m' \
                '\033[1;37m' "$ODIR"/.ffmpeg_merge/"$FILE" '\033[0m'
        ;;
        *)
            # guaranteed move, no need for guard
            # `-f` because typically output loc/name might match input loc
            mv -f "$FILE" "$DIR"/"$FILE"

            printf "%b%s%b %b%s%b\n" \
                '\033[1;32m' 'FILE:' '\033[0m' \
                '\033[1;37m' "$DIR"/"$FILE" '\033[0m'
        ;;
    esac

    # remaining unrelated stuff to do
    if [ "$_destroy_cookies" ]; then
        rm -f "$COOKIES"
        printf "%s\n" "Deleted the cookies '$COOKIES'."
    fi
}

ytd "$@"
