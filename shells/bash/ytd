#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

ytd() {
    err() {
        trap - INT TERM EXIT

        if [ "$1" != 0 ]; then
            printf "%s" \
'
$1 -> url
$2 -> fname
$3 *0* -> `--format bestaudio[format_id~=^140][language^=en]`, yt-dlp only
$3 *1* -> `--format bestvideo[height<=1080]`, yt-dlp only
$3 *2* -> `--format bestvideo[height<=1440]`, yt-dlp only
$3 *3* -> dont use cookies,                                    yt-dlp only
$3 *a* -> write the auto-generated subs
$3 *b* -> `--format bestaudio`, `--format bestvideo`
$3 *f* -> dont recognize/append extension, fname is fully authoritative
$3 *m* -> dont use `--mtime`
$3 *n* -> `--fixup never`
$3 *o* -> dont use `-o` / dont custom format filename
$3 *s* -> convert subtitles to `srt` using ffmpeg before embed
$3 *t* -> `--no-part --no-cache-dir`, no cleanup/move (only on success)
$3 *u* -> download in current dir
$3 *v* -> `--verbose`
$3 *x* -> dont try to download any subtitles
$3 *y* -> use yt-dlp
$3 *z* -> use youtube-dl
'

            rm -rf "$ODIR"/.ffmpeg_merge "$ODIR"/.yt_a "$ODIR"/.yt_s "$ODIR"/.yt_v
        fi

        case "$OPTS" in
            *t*) : ;;
            *) rm -rf "$ODIR"/.ffmpeg_merge "$ODIR"/.yt_a "$ODIR"/.yt_s "$ODIR"/.yt_v ;;
        esac

        exit "$1"
    }

    set -e
    trap "err \$?" INT TERM EXIT

    URL="$1"
    FNAME="$2"
    OPTS="$3"
    DIR="$PWD"
    FILE=

    case "$OPTS" in
        *u*) ODIR="$DIR" ;;
        *) ODIR="${TMPDIR:-/tmp}" ;;
    esac

    [ "$URL" ] || { printf "%s\n" 'No URL specified.'; exit 2; }

    # download audio first to prematurely discover any problems
    yt_a "$URL" '' t"$OPTS"
    yt_v "$URL" '' t"$OPTS"
    case "$OPTS" in
        *x*)
            echo 'Will not try to download any subtitles.'
        ;;
        *)
            s=0
            echo 'Querying subtitles...'

            case "$OPTS" in
                *a*)
                    if yt_s "$URL" '' t"$OPTS" > /dev/null; then
                        s=2
                    fi
                ;;
                *)
                    if yt_s "$URL" '' t"$OPTS" > /dev/null; then
                        s=1
                    elif yt_s "$URL" '' at"$OPTS" > /dev/null; then
                        s=2
                    fi
                ;;
            esac

            case "$s" in
                0) printf "%b%s%b\n" '\033[1;37m' 'No subtitles available.' '\033[0m' ;;
                1) printf "%b%s%b\n" '\033[1;37m' 'Subtitles available.' '\033[0m' ;;
                2) printf "%b%s%b\n" '\033[1;37m' 'Auto-generated subtitles available.' '\033[0m' ;;
            esac
        ;;
    esac

    # construct $OPTS as $1 for ffmpeg_merge
    case "$OPTS" in
        *u*) set -- tu ;;
        *) set -- t ;;
    esac

    if [ "$s" = 0 ]; then
        ffmpeg_merge "$ODIR"/.yt_v/* "$ODIR"/.yt_a/* '' "$1"
    else
        ffmpeg_merge "$ODIR"/.yt_v/* "$ODIR"/.yt_a/* "$ODIR"/.yt_s/* '' s"$1"
    fi

    # from now on guarantee $FILE is just the filename as we are in our dir
    # simplifies operations
    cd "$ODIR"/.ffmpeg_merge
    FILE=$(set -- *; printf "%s" "$1.")
    FILE="${FILE%.}"
    FILE="${FILE##*/}"

    # rename in our dir
    # if $FILE has extension, append it to $FNAME
    if [ "$FNAME" ]; then
        case "$OPTS" in
            *f*)
                :
            ;;
            *)
                case "$FILE" in
                    *.?? | *.??? | *.????) FNAME="$FNAME.${FILE##*.}" ;;
                esac
            ;;
        esac

        # guard same filename rename
        case "$FILE" in
            "$FNAME") : ;;
            *) mv "$FILE" "$FNAME" ;;
        esac

        FILE="$FNAME"
    fi

    # move result to dest
    case "$OPTS" in
        *t*)
            rm -rf "$ODIR"/.yt_a "$ODIR"/.yt_s "$ODIR"/.yt_v

            printf "%b%s%b %b%s%b\n" \
                '\033[1;32m' 'FILE:' '\033[0m' \
                '\033[1;37m' "$ODIR"/.ffmpeg_merge/"$FILE" '\033[0m'
        ;;
        *)
            # guaranteed move, no need for guard
            # `-f` because typically output loc/name might match input loc
            mv -f "$FILE" "$DIR"/"$FILE"

            printf "%b%s%b %b%s%b\n" \
                '\033[1;32m' 'FILE:' '\033[0m' \
                '\033[1;37m' "$DIR"/"$FILE" '\033[0m'
        ;;
    esac
}

ytd "$@"
