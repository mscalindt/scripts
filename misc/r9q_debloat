main_post() {
    updates=1
    printf "%s" "Shall all updates to system apps be listed? [y/N] "
    read -r _action; [ "$_action" ] || _action=N
    case "$_action" in
        [Yy]*)
            info_white 'Will list all updates to system apps...'
            _updates=$(
                pm list packages -s | while read -r PKG; do
                    PKG="${PKG#package:}"
                    case "$(dumpsys package "$PKG" < /dev/null)" in
                        *UPDATED_SYSTEM_APP*)
                            pm list packages -i "$PKG" < /dev/null
                        ;;
                    esac
                done
            )
            if [ ! "$_updates" ]; then
                info_white 'No system app updates found.'
                updates=
            fi
        ;;
    esac
    if [ "$updates" ]; then
        # It is not desired to end up in a state where system apps have been
        # updated by Google Play Store and any similar lock-in stores.
        # So, prompt to remove all system app updates.
        printf "%s" "Shall all updates to system apps be removed? [y/N] "
        read -r _action; [ "$_action" ] || _action=N
        case "$_action" in
            [Yy]*)
                info_white 'Will remove all updates to system apps...'
                # this method in PackageManagerShellCommand.java returns 1 on
                # success and 0 on failure. just to blow your mind.
                pm uninstall-system-updates || :
            ;;
        esac
    fi

    disabled=
    ! pkg_disabled com.google.android.gms || disabled=1
    if [ ! "$disabled" ]; then
        printf "%s" "Shall Google Play services be disabled? [y/N] "
        read -r _action; [ "$_action" ] || _action=N
        case "$_action" in
            [Yy]*)
                pkg_disable com.google.android.gms # Google Play services
                disabled=1
            ;;
        esac
    fi
    if [ ! "$disabled" ]; then
        # Try this only if you are experiencing any Google Play services issues,
        # because it may reset privacy-related settings.
        printf "%s" "Shall the data of Google Play services be cleared? [y/N] "
        read -r _action; [ "$_action" ] || _action=N
        case "$_action" in
            [Yy]*) pkg_clr com.google.android.gms # Google Play services ;;
        esac
    fi
}

main_pre() {
    # The Google Play Store app has some ("complete setup") logic to
    # automatically install bloatware (yes, actual, unrelated bloatware,
    # besides "stock"-defined one) when it detects any system apps that
    # have not been updated or have had their updates by Google Play Store
    # (installer=com.android.vending) reverted.
    #
    # This is malicious behavior, so remove the app. It is assumed you have
    # manually installed any store-exclusive APKs by other means and/or
    # will update any system apps manually, after the full debloat, and you
    # do not need any apps/services that depend on store functionality.
    pkg_rm com.android.vending # Google Play Store
    # Due to the aforementioned paragraph, remove any "setup wizards". Google
    # login continues to work.
    pkg_rm android.autoinstalls.config.samsung # ConfigAPK
    pkg_rm com.google.android.apps.setupwizard.searchselector # Search Engine Selector
    pkg_rm com.google.android.partnersetup # Google Partner Setup
    pkg_rm com.google.android.setupwizard # Android Setup
    pkg_rm com.samsung.android.dbsc # Galaxy Service Setup
    pkg_rm com.sec.android.app.SecSetupWizard # Samsung SetupWizard
    pkg_rm com.sec.android.app.setupwizardlegalprovider # SetupWizardLegalProvider
}

main_services() {
    :
}

main() {
    set -e
    LC_ALL=C; export LC_ALL

    trap 'err $?' INT TERM EXIT

    pm list packages > /dev/null 2>&1 || { err_red 'Not in Android shell.'; return 2; }
    hash date pm > /dev/null 2>&1
    DEVICE_MODEL=$(getprop ro.product.model)
    DEVICE_SN=$(getprop ro.serialno)
    DEVICE="$DEVICE_MODEL $DEVICE_SN"

    info_white "Connected device:"
    info_white "$DEVICE"

    PKG_LIST=$(pm list packages)
    PKG_LIST_DISABLED=$(pm list packages -d)

    printf "%s" "Skip debloat phase? [y/N] "
    read -r _action; [ "$_action" ] || _action=N
    case "$_action" in
        [Yy]*)
        ;;
        *)
            # preliminary stuff to do before debloat
            main_pre;

            # TP1A.220624.014.G990B2XXU1DVK3
            main_android_13;

            # BP2A.250605.031.A3.G990B2XXSKIZH2
            main_android_16;

            main_services;
        ;;
    esac

    main_post;

    info_white "Reboot the device."

    err 0
}

main "$@"
