err() {
    case "$1" in
        0) info_white "$0: Exiting with $1. You can now send EOF to cat." ;;
        *) info_red "$0: Exiting with $1. You can now send EOF to cat." ;;
    esac
    trap - INT TERM EXIT
    exit "$1"
}

err_red() {
    printf "%b[%s] =>>: %b%s%b\n" '\033[1;31m' "$(date "+%H:%M:%S")" \
                                  '\033[1;37m' "$*" '\033[0m' 1>&2
}

info_blue() {
    printf "%b[%s] =>>: %b%s%b\n" '\033[1;34m' "$(date "+%H:%M:%S")" \
                                  '\033[1;37m' "$*" '\033[0m'
}

info_green() {
    printf "%b[%s] =>>: %b%s%b\n" '\033[1;32m' "$(date "+%H:%M:%S")" \
                                  '\033[1;37m' "$*" '\033[0m'
}

info_white() {
    printf "%b[%s] =>>: %b%s%b\n" '\033[1;37m' "$(date "+%H:%M:%S")" \
                                  '\033[1;37m' "$*" '\033[0m'
}

pkg_disable() (
    ! pkg_disabled "$1" || return 0

    DIR='/storage/emulated/0/Android'

    pm clear --user 0 "$1" > /dev/null 2>&1 || :
    { OP=$(pm disable-user --user 0 "$1" 2>&1) && RC=0; } || RC="$?"
    if [ "$RC" -eq 0 ]; then
        info_blue "pkg_disable: $1: RC=$RC"; info_green "$OP"
    else
        { info_blue "pkg_disable: $1: RC=$RC"; err_red "$OP"; } >&2
        return 0
    fi
)

pkg_disabled() {
    case "
$PKG_LIST_DISABLED
" in
        *"
package:$1
"*)
            return 0
        ;;
    esac

    return 1
}

pkg_removed() {
    case "
$PKG_LIST
" in
        *"
package:$1
"*)
            return 1
        ;;
    esac

    return 0
}

pkg_rm() (
    ! pkg_removed "$1" || return 0

    DIR='/storage/emulated/0/Android'

    pm clear --user 0 "$1" > /dev/null 2>&1 || :
    { OP=$(pm uninstall --user 0 "$1" 2>&1) && RC=0; } || RC="$?"
    if [ "$RC" -eq 0 ]; then
        info_blue "pkg_rm: $1: RC=$RC"; info_green "$OP"
    else
        { info_blue "pkg_rm: $1: RC=$RC"; err_red "$OP"; } >&2
        return 0
    fi
    rm -rf "$DIR/data/$1" "$DIR/media/$1" "$DIR/obb/$1" 2> /dev/null
)

pkg_rm_or_disable() (
    { ! pkg_removed "$1" && ! pkg_disabled "$1"; } || return 0

    _RC=
    DIR='/storage/emulated/0/Android'

    pm clear --user 0 "$1" > /dev/null 2>&1 || :

    { OP1=$(pm uninstall --user 0 "$1" 2>&1) && RC=0; } || \
    { _RC="$?"; OP2=$(pm disable-user --user 0 "$1" 2>&1) && RC=0; } || \
    RC="$?"

    if [ "$RC" -eq 0 ] && [ ! "$_RC" ]; then
        info_blue "pkg_rm: $1: RC=$RC"; info_green "$OP1"
    elif [ "$RC" -eq 0 ]; then
        info_blue "pkg_disable: $1: RC=$RC"; info_green "$OP2"
    else
        {
            info_blue "pkg_rm_or_disable: $1: RC1=$_RC, RC2=$RC"
            err_red "$OP1"
            err_red "$OP2"
        } >&2
        return 0
    fi
    rm -rf "$DIR/data/$1" "$DIR/media/$1" "$DIR/obb/$1" 2> /dev/null
)

pkg_clr() (
    DIR='/storage/emulated/0/Android'

    { OP=$(pm clear --user 0 "$1" 2>&1) && RC=0; } || RC="$?"
    if [ "$RC" -eq 0 ]; then
        info_blue "pkg_clr: $1: RC=$RC"; info_green "$OP"
    else
        { info_blue "pkg_clr: $1: RC=$RC"; err_red "$OP"; } >&2
        return 0
    fi
    rm -rf "$DIR/data/$1"/* 2> /dev/null
)

