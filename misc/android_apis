# > Disable a package for user 0
# Arguments: <"$1"> - package name
pkg_disable() {
    pm disable-user --user 0 "$1"
}

# > Enable a package for user 0
# Arguments: <"$1"> - package name
pkg_enable() {
    pm enable --user 0 "$1"
}

# > Install an APK contained in URL for user 0
# Arguments: <"$1"> - APK URL
pkg_install() (
    _errh() {
        trap - INT TERM EXIT
        rm -rf "$DIR"
        return "$1"
    }
    trap '_errh $?' INT TERM EXIT; set -e

    DIR='/data/local/tmp/pkg_install'
    FILE='/data/local/tmp/pkg_install/00.apk'

    rm -rf "$DIR"
    mkdir -p "$DIR"
    curl --location "$1" --output "$FILE"
    pm install --user 0 "$FILE"

    _errh 0
)

# > Install an APK split into chunks contained in URLs for user 0
# Arguments: <"$1+"> - APK URL of sequential chunk
pkg_install_chunks() (
    _errh() {
        trap - INT TERM EXIT
        rm -rf "$DIR"
        return "$1"
    }
    trap '_errh $?' INT TERM EXIT; set -e

    DIR='/data/local/tmp/pkg_install_chunks'
    DIR_CHUNKS='/data/local/tmp/pkg_install_chunks/chunks'
    FILE='/data/local/tmp/pkg_install_chunks/00.apk'

    rm -rf "$DIR"
    mkdir -p "$DIR" "$DIR_CHUNKS"
    cd "$DIR_CHUNKS"
    for url in "$@"; do
        curl --location "$url" --output 0"$((${cnt:-0} + 1))".apk &
        cnt=$((cnt + 1))
    done; wait
    cat * > "$FILE"
    pm install --user 0 "$FILE"

    _errh 0
)

# > Remove (uninstall) a package for user 0
# Arguments: <"$1"> - package name
pkg_remove() (
    _errh() {
        trap - INT TERM EXIT
        return "$1"
    }
    trap '_errh $?' INT TERM EXIT; set -e

    DIR='/storage/emulated/0/Android'

    pm uninstall --user 0 "$1"
    rm -rf "$DIR/data/$1"
    rm -rf "$DIR/media/$1"
    rm -rf "$DIR/obb/$1"
)

# > Reset (clear all data of) a package for user 0
# Arguments: <"$1"> - package name
pkg_reset() (
    _errh() {
        trap - INT TERM EXIT
        return "$1"
    }
    trap '_errh $?' INT TERM EXIT; set -e

    DIR='/storage/emulated/0/Android'

    pm clear --user 0 "$1"

    rm -rf "$DIR/data/$1"/*
)

# > Restore (reinstall) deleted system package for user 0
# Arguments: <"$1"> - package name
pkg_restore() {
    pm install-existing --user 0 "$1"
}
